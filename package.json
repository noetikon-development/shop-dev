{
  "name": "lumo-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:config": "node --env-file=.env scripts/seed-inventory-settings.mjs",
    "db:seed:auth": "node --env-file=.env scripts/seed-auth-users.mjs",
    "db:seed:rbac": "node --env-file=.env --import tsx scripts/seed-rbac.ts",
    "db:seed:settings": "node --env-file=.env --import tsx scripts/seed-admin-foundation.ts",
    "db:seed:cms": "node --env-file=.env --import tsx scripts/seed-cms.ts",
    "storage:setup": "node --env-file=.env scripts/setup-storage.mjs",
    "db:rls": "node --env-file=.env scripts/apply-rls.mjs",
    "db:dump-seed": "node --env-file=.env scripts/dump-seed-sql.mjs",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "nodemailer": "^9.0.6",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
