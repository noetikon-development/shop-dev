# ---------------------------------------------------------------------------
# Copy to .env for local development. Set the same values in your Vercel
# project (Settings -> Environment Variables) for the deployed app.
# ---------------------------------------------------------------------------

# ---- Database (Prisma -> Supabase Postgres) --------------------------------
# From Supabase dashboard -> Connect -> ORMs / Prisma
# DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true   -> app runtime
# DIRECT_URL   = Session pooler / direct (port 5432)                 -> migrations / seed
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Supabase Auth --------------------------------------------------------
# From Supabase dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="the anon / public key"

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never expose to the browser.
# Only needed for scripts/seed-auth-users.mjs (creating the demo accounts).
SUPABASE_SERVICE_ROLE_KEY="the service_role / secret key"

# ---- Site ---------------------------------------------------------------
# Optional on Vercel (falls back to the deployment URL). Locally match your dev port.
NEXT_PUBLIC_SITE_URL="http://localhost:3400"

# ---- Transactional email (Step 17) --------------------------------------
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Provider-agnostic SMTP — works
# with Resend, SendGrid, Postmark, Mailgun, SES, or any SMTP relay.
#
# If EMAIL_HOST / EMAIL_USER / EMAIL_PASSWORD are not all set, the app records
# every email in the EmailLog table with status SKIPPED and never sends — no
# credentials are invented for the demo. Set all three to enable real delivery
# (no redeploy needed if set as Vercel env vars and the function restarts).
EMAIL_HOST="smtp.your-provider.com"
EMAIL_PORT="587"                 # 465 = implicit TLS, 587 = STARTTLS (default 587)
EMAIL_USER="the SMTP username / API user"
EMAIL_PASSWORD="the SMTP password / API key"
EMAIL_FROM="orders@yourdomain.com"        # verified sender; defaults to EMAIL_USER
EMAIL_FROM_NAME="Axiaro"                  # display name; defaults to the store brand
EMAIL_REPLY_TO="support@yourdomain.com"   # optional
# EMAIL_MODE="log"               # optional: force record-only even with creds set
