// AXIARO — e-commerce data model
// PostgreSQL (works on Vercel / any serverless host). No enums / scalar lists;
// JSON-shaped data is stored as String columns and parsed in the app layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection string (e.g. Neon "pooled" / Vercel POSTGRES_PRISMA_URL).
  url       = env("DATABASE_URL")
  // Non-pooled/direct string, used by `prisma migrate` and `prisma db push`.
  // Set this to the same value as DATABASE_URL if your provider has no separate direct URL.
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Customers
//
// Authentication is handled by Supabase Auth (auth.users). This table holds
// application data only — NO passwords. `supabaseUserId` is the 1:1 link to the
// Supabase Auth user; it is set server-side on first authenticated request.
// ----------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  supabaseUserId String?   @unique
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  // Coarse account type, kept as a convenience mirror of the RBAC tables:
  // "ADMIN" when the user holds one or more admin roles, otherwise "CUSTOMER".
  // Authorization is ALWAYS resolved from UserRole / RolePermission — never
  // from this column. See src/lib/admin/rbac.ts.
  role           String    @default("CUSTOMER") // CUSTOMER | ADMIN
  phone          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  returnRequests ReturnRequest[]
  reviews   Review[]
  wishlist  WishlistItem[]
  questions ProductQuestion[]
  answers   ProductAnswer[]
  carts     Cart[]
  emailLogs EmailLog[]
  signInDevices SignInDevice[]

  couponRedemptions CouponRedemption[]

  // RBAC / admin
  userRoles            UserRole[]
  invitesSent          AdminInvite[]         @relation("AdminInviteInvitedBy")
  invitesAccepted      AdminInvite[]         @relation("AdminInviteAcceptedBy")
  auditEvents          AdminAuditLog[]       @relation("AdminAuditActor")
  inventoryAdjustments InventoryAdjustment[] @relation("InventoryAdjustmentActor")

  // Marketplace (Phase 9C foundation). Back-relation only — no column on User.
  sellerUsers          SellerUser[]

  // Analytics (Step 18): new-customers-in-period is a createdAt range scan.
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// RBAC — roles & permissions
//
// Data-driven: the initial catalogue lives in src/lib/rbac/catalog.ts and is
// applied by `npm run db:seed:rbac`. The application reads roles/permissions
// from these tables at request time; nothing is hardcoded in the auth path.
// New roles / permissions can be added later without code changes to the
// authorization layer.
// ----------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // stable machine key, e.g. "SUPER_ADMIN"
  name        String // human label, e.g. "Super Admin"
  description String?
  // System roles ship with the product and cannot be deleted from the UI.
  isSystem    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
  invites         AdminInvite[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "view_products"
  description String?
  group       String   @default("General") // UI grouping, e.g. "Products"
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([group])
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  // User.id of the admin who granted this role (null for seeded assignments).
  assignedBy String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// A pending admin invitation. Created only by a SUPER_ADMIN action; the row is
// the trusted record of the intended role (never trust client input or
// Supabase user_metadata for this). Claimed server-side on the invitee's first
// authenticated request.
model AdminInvite {
  id             String    @id @default(cuid())
  email          String // lower-cased
  roleId         String
  invitedById    String
  status         String    @default("PENDING") // PENDING | ACCEPTED | REVOKED
  supabaseUserId String? // Supabase auth user id created by the invite email
  acceptedById   String?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  role       Role  @relation(fields: [roleId], references: [id])
  invitedBy  User  @relation("AdminInviteInvitedBy", fields: [invitedById], references: [id])
  acceptedBy User? @relation("AdminInviteAcceptedBy", fields: [acceptedById], references: [id])

  @@index([email])
  @@index([status])
  @@index([roleId])
  @@index([invitedById])
}

// Append-only trail of security-sensitive admin actions (logins, invitations,
// role changes). Surfaced read-only to holders of `view_audit_logs`.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String // e.g. "admin.login", "admin.role.assign"
  targetType  String? // e.g. "user", "invite"
  targetId    String?
  summary     String? // short human-readable description
  meta        String   @default("{}") // JSON-encoded detail
  createdAt   DateTime @default(now())

  actor User? @relation("AdminAuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

// A customer's saved address (Step 8). Belongs to exactly one User. All access
// is server-side through src/lib/addresses.ts with an ownership check on every
// call — the browser never supplies a userId or an ownership claim. `country`
// is an ISO-3166-1 alpha-2 code validated against src/lib/countries.ts (PH
// only today, extensible). `defaultShipping` / `defaultBilling` are independent;
// partial unique indexes (supabase/migrations/20260830120000_address_step8.sql)
// enforce at most one of each per user. Field set is intentionally flat so new
// fields can be added later without restructuring.
model Address {
  id              String   @id @default(cuid())
  userId          String
  label           String   @default("Home")
  firstName       String
  lastName        String
  company         String?
  phone           String
  line1           String
  line2           String?
  barangay        String? // PH: barangay
  city            String
  province        String // state / province / region
  region          String? // PH: administrative region (e.g. NCR)
  postalCode      String
  country         String   @default("PH")
  defaultShipping Boolean  @default(false)
  defaultBilling  Boolean  @default(false)
  // Denormalised "firstName lastName". Maintained on every write; kept so the
  // checkout prefill and the order address snapshot keep working unchanged.
  recipient       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipToOrders Order[] @relation("OrderShipTo")
  billToOrders Order[] @relation("OrderBillTo")

  @@index([userId])
  @@index([userId, defaultShipping])
  @@index([userId, defaultBilling])
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------

model Category {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String?
  imageUrl     String? // resolved public URL of `imageMedia` (kept for the storefront read path)
  imageMediaId String? // uploaded image in Supabase Storage (Step 5 admin)
  heroColor    String? // used for category tiles / headers
  sortOrder    Int     @default(0)
  featured     Boolean @default(false)
  active       Boolean @default(true) // inactive / archived categories are hidden from the storefront

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products   Product[]
  imageMedia MediaAsset? @relation("CategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([active])
}

model Product {
  id               String @id @default(cuid())
  name             String
  slug             String @unique
  brand            String @default("Axiaro")
  shortDescription String
  description      String // long-form, supports line breaks
  categoryId       String
  status           String @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED

  price          Int // selling price, in centavos
  compareAtPrice Int? // original price for showing a markdown
  costPrice      Int?

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)
  soldCount   Int   @default(0)

  badges     String  @default("[]") // JSON string: ["new","bestseller"]
  highlights String  @default("[]") // JSON string: bullet list of selling points
  specs      String  @default("{}") // JSON string: { "Material": "Oak", ... }
  care       String?

  freeShipping Boolean @default(false)
  featured     Boolean @default(false) // admin-controlled; drives future "featured products" merchandising
  weightGrams  Int     @default(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category        @relation(fields: [categoryId], references: [id])
  images    ProductImage[]
  questions ProductQuestion[]
  options  ProductOption[]
  variants Variant[]
  reviews  Review[]
  wishedBy WishlistItem[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String // `art:<kind>:<seed>` for seeded illustrations, or a Storage public URL for uploads
  alt       String @default("")
  // `sortOrder` is scoped to the (productId, optionValueId) group: images for a
  // given colour are ordered independently, and the lowest sortOrder in a group
  // is that group's primary image.
  sortOrder Int    @default(0)
  // Explicit link to a Colour option value (ProductOptionValue). NULL = the
  // image applies to the whole product ("all colours"). The storefront gallery
  // is driven by THIS relation — never by the filename, slug or image content.
  optionValueId String?
  // set when the image was uploaded via the admin (Supabase Storage / MediaAsset)
  mediaAssetId String?

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)
  mediaAsset  MediaAsset?         @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([optionValueId])
  @@index([mediaAssetId])
}

model ProductOption {
  id        String @id @default(cuid())
  productId String
  name      String // "Colour", "Size"
  sortOrder Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id        String  @id @default(cuid())
  optionId  String
  value     String // "Sand", "Large"
  swatchHex String? // for colour options
  sortOrder Int     @default(0)

  option        ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantValues VariantOptionValue[]
  images        ProductImage[]

  @@index([optionId])
}

model Variant {
  id             String  @id @default(cuid())
  productId      String
  sku            String  @unique
  price          Int // absolute price for this variant, in centavos
  compareAtPrice Int?
  status         String  @default("ACTIVE") // ACTIVE | ARCHIVED (archived = not purchasable)
  // Denormalised AVAILABLE stock (Inventory.quantity - Inventory.reserved). The
  // storefront reads this; every inventory mutation in src/lib/inventory.ts
  // keeps it in sync. Inventory is the source of truth.
  stock          Int     @default(0)
  imageUrl       String?

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  inventory    Inventory?
  // Marketplace (Phase 9C foundation). Back-relation only — no column on Variant.
  // A catalog Variant may carry many seller Offers; in Phase 9C there is exactly
  // one (the Axiaro FIRST_PARTY offer) per ACTIVE variant.
  offers       Offer[]

  @@index([productId])
  @@index([status])
}

// Per-variant stock ledger — exactly one row per Variant (variantId @unique).
// `quantity` is on-hand; `reserved` is allocated but not yet shipped;
// available = quantity - reserved. DB CHECK constraints (see
// supabase/migrations/20260829140100_rls_and_grants.sql) enforce
// quantity >= 0, reserved >= 0, quantity >= reserved, reorderPoint >= 0.
// Stock status (IN_STOCK / LOW_STOCK / OUT_OF_STOCK) is DERIVED, not stored —
// see src/lib/inventory-status.ts.
model Inventory {
  id           String    @id @default(cuid())
  variantId    String    @unique
  sku          String
  quantity     Int       @default(0)
  reserved     Int       @default(0)
  reorderPoint Int       @default(3) // low-stock threshold, compared against available
  restockEta   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  variant     Variant               @relation(fields: [variantId], references: [id], onDelete: Cascade)
  adjustments InventoryAdjustment[]

  @@index([variantId])
}

// Append-only history of every quantity change to an Inventory row. `delta` is
// signed; `reason` is an open string (INITIAL_STOCK, RESTOCK, MANUAL_ADJUSTMENT,
// DAMAGE, LOSS, RETURN, CORRECTION, SALE, …) so new reasons need no migration.
model InventoryAdjustment {
  id               String   @id @default(cuid())
  inventoryId      String
  previousQuantity Int
  delta            Int
  newQuantity      Int
  reason           String
  note             String?
  actorUserId      String?
  createdAt        DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  actor     User?     @relation("InventoryAdjustmentActor", fields: [actorUserId], references: [id])

  @@index([inventoryId])
  @@index([reason])
  @@index([createdAt])
  @@index([actorUserId])
}

// join: which option values define a given variant
model VariantOptionValue {
  variantId     String
  optionValueId String

  variant     Variant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

// ----------------------------------------------------------------------------
// Reviews & wishlist
// ----------------------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  orderId   String? // the DELIVERED order that establishes the verified purchase (server-set)
  rating    Int // 1-5; validated server-side
  title     String?
  body      String
  verified  Boolean  @default(false) // computed from a DELIVERED order — never client-supplied
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([productId, userId]) // one review per customer per product (Step 15)
  @@index([productId])
  @@index([status])
  @@index([productId, status])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Product Q&A (Step 15). User-generated content — everything is moderated.
// ----------------------------------------------------------------------------

model ProductQuestion {
  id        String   @id @default(cuid())
  productId String
  userId    String
  body      String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ProductAnswer[]

  @@index([productId])
  @@index([status])
  @@index([productId, status])
  @@index([userId])
}

model ProductAnswer {
  id         String   @id @default(cuid())
  questionId String
  authorId   String? // the User who wrote it; null if that user is later deleted
  authorType String   @default("STORE") // STORE (official "Axiaro Team") | CUSTOMER
  body       String
  status     String   @default("APPROVED") // STORE answers are official; still moderatable
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([questionId])
  @@index([status])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Cart (Step 7)
//
// One row per shopping session. Ownership is EITHER a signed-in customer
// (`userId`) OR an anonymous guest (`token`, carried in an httpOnly cookie —
// the browser never sees a cart id). A partial unique index (see
// supabase/migrations/20260829140100_rls_and_grants.sql §7) enforces exactly
// one ACTIVE cart per user. `status` lifecycle: ACTIVE -> CONVERTED (order
// placed) / ABANDONED. All cart mutations go through src/lib/cart.ts, which
// re-validates the variant, product status, price and available inventory
// server-side on every operation. A cart is NOT a stock reservation.
// ----------------------------------------------------------------------------

model Cart {
  id         String   @id @default(cuid())
  userId     String?
  token      String?  @unique // opaque guest identifier (httpOnly cookie), null for customer carts
  status     String   @default("ACTIVE") // ACTIVE | CONVERTED | ABANDONED
  couponCode String? // applied promo code (canonical form); NOT authoritative — re-validated at checkout (Step 14)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
  order Order? // set once the cart is CONVERTED into an order (Step 9)

  @@index([userId])
  @@index([status])
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  variantId     String
  // Marketplace offer binding. The specific Seller Offer this line is bound to —
  // resolved SERVER-SIDE at add-to-cart with the buy-box rule. Phase 9E-2: now
  // REQUIRED and the line-identity column. A cart may hold two lines for the
  // same Variant when they are different Sellers' Offers; it may hold at most
  // one line per Offer (`@@unique([cartId, offerId])`). `variantId` is retained
  // permanently as the catalog anchor (image / options / product link). The
  // bound Offer is NOT re-picked on cart read — no silent seller switch — and
  // it is NOT the authoritative billing record (that stays an Order-time
  // concern). FK is `onDelete: Cascade` (a NOT-NULL column cannot be nulled;
  // matches `variant`) — offers are soft-retired via `status`, never hard-
  // deleted in normal operation.
  offerId       String
  quantity      Int
  // Display cache only — the authoritative live price is the bound Offer's
  // price, read on every getCart / mutation. Refreshed on add-to-cart writes.
  priceSnapshot Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([cartId, offerId])
  @@index([cartId])
  @@index([variantId])
  @@index([offerId])
}

// ----------------------------------------------------------------------------
// Promotions
// ----------------------------------------------------------------------------

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique // canonical, UPPERCASE alphanumeric
  description String?
  type        String // PERCENT | FIXED  (FREESHIP kept in data; free-shipping coupons are a later step)
  value       Int       @default(0) // percent (1-100) or centavos
  minSubtotal Int       @default(0) // centavos; 0 = no minimum
  maxDiscount Int? // centavos; caps a PERCENT discount
  startsAt    DateTime?
  expiresAt   DateTime?
  usageLimit       Int? // global redemption cap
  perCustomerLimit Int? // per-customer redemption cap (Step 14)
  usedCount        Int      @default(0) // loose display mirror — CouponRedemption is the source of truth
  active           Boolean  @default(true)
  archivedAt       DateTime? // soft archive (Step 14); distinct from active/inactive
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]

  @@index([active])
  @@index([archivedAt])
}

// One row per successful coupon application (Step 14). This is the authoritative
// record for enforcing global + per-customer usage limits: the checkout
// transaction takes `SELECT ... FOR UPDATE` on the parent Coupon row, then
// COUNTs redemptions whose Order is not CANCELLED. Cancelling an order therefore
// frees the entitlement without deleting the audit row.
model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String?
  orderId   String   @unique // exactly one redemption per order
  code      String // snapshot of the coupon code
  amount    Int // discount amount applied, centavos
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
  // Analytics (Step 18): coupon redemptions in a date range.
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique
  userId      String?
  email       String
  phone       String?

  status String @default("PENDING")
  // PENDING_PAYMENT | PENDING | PAID | PROCESSING | SHIPPED | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  // Step 9 checkout creates orders as PENDING_PAYMENT (payment is a later step).

  subtotal      Int
  shippingFee   Int @default(0)
  discountTotal Int @default(0)
  grandTotal    Int

  // Coupon / discount — a live link plus an immutable snapshot (Step 14).
  // Historical totals never depend on the current Coupon record.
  couponId      String?
  couponCode    String? // snapshot of the code used
  discountType  String? // snapshot: "PERCENT" | "FIXED"
  discountValue Int? // snapshot: the coupon's value at order time (percent or centavos)
  // discountTotal (above) is the snapshotted discount amount applied.

  paymentMethod String @default("COD") // COD | CARD | GCASH | NONE (no method until the payment step)
  paymentStatus String @default("UNPAID") // PENDING | UNPAID | PAID | REFUNDED

  // The ACTIVE cart this order was created from. `@unique` guarantees one order
  // per cart — the DB-level guard against double submission.
  cartId String? @unique

  addressId        String? // shipping address, live link (may be edited/deleted later)
  billingAddressId String? // billing address, live link
  shippingAddress  String // immutable JSON snapshot taken at order time
  billingAddress   String? // immutable JSON snapshot; null = billed to the shipping address

  // Shipping method — a live link plus an immutable snapshot (Step 11). Historical
  // totals never depend on the current ShippingMethod record.
  shippingMethodId   String? // live link (SetNull if the method is later removed)
  shippingMethod     String  @default("standard") // legacy id / code, kept for compatibility
  shippingMethodCode String? // snapshot: e.g. "STANDARD"
  shippingMethodName String? // snapshot: e.g. "Standard Delivery"
  // shippingFee (above) is the snapshotted amount charged.

  // Fulfilment / courier / tracking (Step 13). Operational order data — NOT part
  // of the historical price/address snapshot, and no second status system: the
  // fulfilment status IS `status` (SHIPPED / OUT_FOR_DELIVERY / DELIVERED).
  // Courier API integration is a later step; `courier` is a code from
  // src/lib/orders/couriers.ts so an API layer can attach without a schema change.
  courier         String? // courier code, e.g. "JT_EXPRESS" | "LBC" | "PICKUP" | "OTHER"
  courierName     String? // display-name snapshot (also holds custom text for "OTHER")
  trackingNumber  String?
  trackingUrl     String? // HTTPS only; auto-built from the courier config or entered by hand
  shippedAt       DateTime? // server-set when the order is marked SHIPPED
  deliveredAt     DateTime? // server-set when the order is marked DELIVERED
  fulfillmentNote String? // internal — never shown to the customer or on public tracking

  note      String?
  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?           @relation(fields: [userId], references: [id])
  cart       Cart?           @relation(fields: [cartId], references: [id])
  address    Address?        @relation("OrderShipTo", fields: [addressId], references: [id])
  billTo     Address?        @relation("OrderBillTo", fields: [billingAddressId], references: [id])
  coupon           Coupon?           @relation(fields: [couponId], references: [id])
  couponRedemption CouponRedemption?
  shipMethod       ShippingMethod?   @relation(fields: [shippingMethodId], references: [id])
  items            OrderItem[]
  events           OrderEvent[]
  reviews          Review[]
  emailLogs        EmailLog[]
  returnRequests   ReturnRequest[]
  payments         Payment[]

  @@index([userId])
  @@index([status])
  @@index([billingAddressId])
  @@index([shippingMethodId])
  // Admin order list (Step 12): default sort is by placedAt; payment status is a
  // list facet.
  @@index([placedAt])
  @@index([paymentStatus])
  // Fulfilment reporting / filtering by courier (Step 13).
  @@index([courier])
}

// Configurable delivery option shown at checkout (Step 11). The `rate` here is
// the CURRENT price; every order snapshots the code / name / amount it used, so
// renaming or repricing a method never changes historical orders. Managed in
// /admin/shipping (permission: manage_shipping). Zone rules are a later step —
// for now the store-wide supported-country list in Store Settings
// (`shipping.countries`) is the only destination check.
model ShippingMethod {
  id          String   @id @default(cuid())
  code        String   @unique // stable machine code: STANDARD | EXPRESS | PICKUP
  name        String
  description String?
  rate        Int      @default(0) // centavos; CHECK rate >= 0
  currency    String   @default("PHP")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([active])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  name         String
  variantLabel String?
  sku          String?
  imageUrl     String?
  unitPrice    Int
  quantity     Int
  lineTotal    Int

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     Variant?     @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
  // Analytics (Step 18): best-selling / product-performance aggregation groups
  // OrderItem by productId (joined to Order for the date/status filter).
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  title     String
  detail    String?
  location  String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ----------------------------------------------------------------------------
// Returns / RMA (Step 21 P3)
//
// A customer-initiated (or admin-assisted) request to return one or more lines
// of a DELIVERED order. Additive only — Order / OrderItem / Variant / Inventory
// are never mutated by this feature. The refund fields are BOOKKEEPING ONLY:
// PayMongo is deferred, no money moves, Order.paymentStatus is not touched.
//
// State machine (src/lib/returns/status.ts):
//   REQUESTED -> APPROVED -> RECEIVED -> REFUND_INITIATED -> REFUND_COMPLETED
//   REQUESTED -> REJECTED                                    (terminal)
//   REQUESTED|APPROVED|RECEIVED|REFUND_INITIATED -> CANCELLED (terminal)
// No backward transitions, no skipped states. Restock happens once, on
// APPROVED -> RECEIVED, through the existing row-locked adjustStock() primitive
// with reason "RETURN".
// ----------------------------------------------------------------------------

model ReturnRequest {
  id           String @id @default(cuid())
  returnNumber String @unique // RET-<YYMMDD>-<nextval("return_number_seq")>

  orderId String
  userId  String? // order owner at request time; null for guest / admin-assisted

  status String @default("REQUESTED")
  // REQUESTED | APPROVED | REJECTED | RECEIVED | REFUND_INITIATED | REFUND_COMPLETED | CANCELLED

  reason       String // DAMAGED | WRONG_ITEM | NOT_AS_DESCRIBED | NO_LONGER_NEEDED | OTHER
  customerNote String? // free text from the customer (sanitised, capped) — shown to admin, escaped in email
  staffNote    String? // internal only — NEVER emailed or shown to the customer
  resolutionNote String? // customer-facing note attached on approve / reject

  // Whether this return was raised by an admin on the customer's behalf, and any
  // eligibility rules that were overridden (audited).
  adminAssisted    Boolean @default(false)
  overriddenRules  String? // JSON array snapshot, e.g. ["window","status"]

  // Refund — BOOKKEEPING ONLY. No gateway, no Payment row, no money movement.
  refundAmount      Int? // centavos
  refundMethod      String? // free-text snapshot: "Original payment method", "Store credit", ...
  refundReference   String? // admin-entered manual reference (bank ref, etc.) — not a gateway id
  refundInitiatedAt DateTime?
  refundCompletedAt DateTime?

  restockedAt DateTime? // set once, on -> RECEIVED (second idempotency guard for the restock)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         ReturnItem[]
  paymentRefund PaymentRefund?

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  // At most one non-terminal return per order is enforced by a partial unique
  // index added in supabase/migrations/20260829140100_rls_and_grants.sql:
  //   CREATE UNIQUE INDEX "return_one_open_per_order" ON "ReturnRequest"("orderId")
  //     WHERE "status" NOT IN ('REJECTED','CANCELLED','REFUND_COMPLETED');
}

model ReturnItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String // the exact order line being returned (ownership + snapshot anchor)

  // Immutable snapshot copied from OrderItem at request time — the return is
  // never recomputed from current Product / Variant data.
  productId    String
  variantId    String?
  name         String
  variantLabel String?
  sku          String?
  unitPrice    Int

  quantity     Int // units being returned (1 .. remaining returnable)
  refundAmount Int // unitPrice * quantity snapshot

  restockQuantity Int     @default(0) // admin sets at receipt; damaged/opened -> 0
  condition       String? // RESELLABLE | DAMAGED | OPENED

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnRequestId, orderItemId])
  @@index([returnRequestId])
  @@index([orderItemId])
}

// ----------------------------------------------------------------------------
// Payments / PayMongo (Step 21 P4, Phase 4-A — DORMANT)
//
// Additive only. Order / OrderItem are never mutated by these tables — Order is
// the immutable commercial snapshot, Payment is the mutable money ledger beside
// it. In Phase 4-A there is NO way to create a Payment row: online payment is
// gated off (`payments.onlinePaymentEnabled = false`), no PayMongo API is ever
// called, and Order.paymentStatus is not written by any P4 code path.
//
// Payment state machine (src/lib/payments/status.ts):
//   PENDING -> AWAITING_PAYMENT -> PAID
//   AWAITING_PAYMENT -> FAILED | EXPIRED | CANCELLED   (terminal-ish; a retry is a new row)
//   PAID -> PARTIALLY_REFUNDED -> REFUNDED
// Every state change is a verified-webhook event, applied inside one atomic,
// status-guarded transaction. Never inferred from browser state, client fetch,
// success_url, EmailLog or admin UI.
//
// NEVER stored here: card numbers, CVV, expiry, provider auth tokens, raw
// provider payloads. Only a provider object id + amount snapshot + method label.
// ----------------------------------------------------------------------------

model Payment {
  id             String @id @default(cuid())
  orderId        String
  provider       String @default("paymongo")
  providerObject String // "checkout_session" | "payment_intent" | "payment"
  providerId     String @unique // ps_xxx / pi_xxx / pay_xxx

  status String @default("PENDING")
  // PENDING | AWAITING_PAYMENT | PAID | FAILED | EXPIRED | CANCELLED
  //   | REFUND_PENDING | PARTIALLY_REFUNDED | REFUNDED

  amount   Int // centavos — snapshot of order.grandTotal at session creation
  currency String @default("PHP")

  method        String? // "card" | "gcash" | "paymaya" | "grab_pay" — from the paid event
  paidAt        DateTime?
  failureReason String? // provider decline reason text — non-sensitive
  checkoutUrl   String? // the hosted PayMongo page (short-lived; "resume payment" link)
  lastEventId   String? // provider evt_xxx of the last webhook that mutated this row
  metadata      String  @default("{}") // JSON — reference_number, line summary. NEVER a secret.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds PaymentRefund[]

  @@index([orderId])
  @@index([status])
  // At most one "active" payment per order is enforced by a partial unique index
  // in supabase/migrations/20260829140100_rls_and_grants.sql:
  //   CREATE UNIQUE INDEX "payment_one_active_per_order" ON "Payment"("orderId")
  //     WHERE "status" IN ('PENDING','AWAITING_PAYMENT','PAID','PARTIALLY_REFUNDED');
}

model PaymentRefund {
  id              String  @id @default(cuid())
  paymentId       String
  returnRequestId String? @unique // the P3 return this settles, if any
  provider        String  @default("paymongo")
  providerId      String? @unique // re_xxx — null until the provider accepts the request

  status String @default("PENDING") // PENDING | PROCESSING | SUCCEEDED | FAILED

  amount        Int
  currency      String  @default("PHP")
  reason        String? // "requested_by_customer" | "duplicate" | "others"
  failureReason String?
  metadata      String  @default("{}")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  succeededAt DateTime?

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([status])
}

// Every inbound provider webhook, for replay protection + idempotent processing.
// `providerId` (evt_xxx) is the dedup key; `payloadHash` catches a tampered
// re-send of a known event id. No secrets, no raw body stored.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("paymongo")
  providerId  String   @unique // evt_xxx
  type        String // "checkout_session.payment.paid" | ...
  status      String   @default("RECEIVED") // RECEIVED | PROCESSED | IGNORED | FAILED
  payloadHash String // sha256(raw body)
  error       String?
  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@index([type])
  @@index([status])
  @@index([receivedAt])
}

// ----------------------------------------------------------------------------
// Transactional email delivery log (Step 17)
//
// One row per transactional email the app tries to send. `idempotencyKey` is a
// deterministic per-event key (e.g. "ORDER_CREATED:<orderId>") with a UNIQUE
// constraint — the send path INSERTs first, so a retry / page refresh / repeated
// callback can never dispatch a duplicate. Email delivery is a side effect: a
// FAILED / SKIPPED row never rolls back the order or status change that
// triggered it. No credentials or message bodies are stored here.
// ----------------------------------------------------------------------------

// Generic fixed-window rate limiter (Step 21 P5). One row per limit key
// (e.g. "contact:email:<hash>"). `count` is the number of hits since
// `windowStart`; a hit after the window has elapsed resets the row. Used by
// the contact form and reusable for other unauthenticated endpoints. Stores
// only a hashed key + counters — no PII. RLS on, no policy.
model RateHit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

// Known sign-in devices (Step 21 P2). One row per (user, user-agent hash) — a
// coarse "have we seen this browser for this account before?" signal used to
// drive the security "new sign-in" alert. Stores NO raw user-agent, NO IP, NO
// token: a SHA-256 hash of the UA (+ server pepper) plus a short human summary
// ("Chrome on Windows"). RLS on, no policy — app reads via the postgres role.
model SignInDevice {
  id          String   @id @default(cuid())
  userId      String
  uaHash      String
  uaSummary   String // e.g. "Chrome on Windows" — not PII, safe to show in email
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, uaHash])
  @@index([userId])
}

model EmailLog {
  id                String    @id @default(cuid())
  type              String // order_confirmation | order_processing | order_shipped | out_for_delivery | order_delivered | order_cancelled | welcome | password_changed | email_changed | sign_in_alert | support_inbound | support_ack | return_requested | return_inbound | return_approved | return_rejected | return_received | return_refund_initiated | return_refund_completed | payment_confirmation | refund_issued | refund_completed | email_verification | password_reset
  recipient         String // destination email address
  subject           String
  idempotencyKey    String    @unique
  status            String    @default("PENDING") // PENDING | SENDING | SENT | FAILED | SKIPPED
  provider          String? // e.g. "smtp"
  providerMessageId String?
  error             String? // failure reason (truncated); never contains secrets
  attempts          Int       @default(0)
  userId            String?
  orderId           String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?
  updatedAt         DateTime  @updatedAt

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([orderId])
  @@index([userId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// Store configuration (key/value). Seeded from src/lib/constants.ts. The
// storefront still reads constants.ts today; moving reads here is a later step.
// ----------------------------------------------------------------------------

model StoreSetting {
  key       String   @id
  value     String // JSON-encoded value
  type      String   @default("string") // string | number | boolean | json
  label     String?
  group     String   @default("general")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([group])
}

// ----------------------------------------------------------------------------
// Admin Panel / CMS foundation (Step 4)
//
// These tables hold the *shape* of CMS content and media — the editor and the
// management UI arrive in later steps. Nothing here is AXIARO-specific: every
// value is data, seeded as an empty/draft starting point.
// ----------------------------------------------------------------------------

// A standalone content page (About, Shipping policy, …). `body` is a serialized
// document (Markdown or a JSON block tree — the app layer decides later).
model ContentPage {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  status         String    @default("DRAFT") // DRAFT | PUBLISHED
  excerpt        String?
  body           String    @default("")
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

// A data-driven block of managed content — a homepage hero, a promo banner, a
// featured-collection strip, etc. `type` selects the payload schema; `data`
// carries it as JSON. Generic on purpose so new block types need no migration.
model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique // stable identifier, e.g. "homepage.hero"
  area      String   @default("homepage") // homepage | global | …
  type      String // hero | banner | collection | featured_products | richtext | …
  title     String?
  data      String   @default("{}") // JSON payload for this block type
  position  Int      @default(0)
  status    String   @default("DRAFT") // DRAFT | PUBLISHED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([area])
  @@index([status])
}

// Metadata for a file stored in Supabase Storage. Binary data never lives in
// Postgres — only the reference + descriptive fields.
model MediaAsset {
  id        String   @id @default(cuid())
  bucket    String   @default("media")
  path      String // object path within the bucket
  url       String // resolved public URL
  filename  String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  alt       String?
  folder    String   @default("") // logical grouping, e.g. "banners", "products"
  createdAt DateTime @default(now())

  productImages  ProductImage[]
  categoryImages Category[]     @relation("CategoryImage")

  @@unique([bucket, path])
  @@index([folder])
  @@index([mimeType])
}

// ----------------------------------------------------------------------------
// Marketplace — Sellers & Offers (Phase 9C foundation)
//
// ADDITIVE FOUNDATION ONLY. As of Phase 9C these tables are NOT authoritative
// for anything customer-facing. Every storefront / cart / checkout price and
// stock read still goes through Product.price / Variant.price / Variant.stock /
// Inventory, exactly as before. `Offer.price` (and compareAtPrice / costPrice)
// is a one-time COPY of the catalog value, taken by the backfill script
// (scripts/backfill-marketplace-foundation.ts). Nothing dual-writes it, and
// src/lib/inventory.ts is untouched — `OfferInventory` is a copied foundation,
// not a live mirror.
//
// Model split (approved Phase 9B design):
//   Product / Variant   — seller-neutral CATALOG identity (what the item is)
//   Seller / Offer       — WHO sells it and on what commercial terms
//   OfferInventory       — stock owned by exactly one Offer
//   OfferAdjustment      — append-only stock history for an OfferInventory
//                          (the future equivalent of InventoryAdjustment)
//
// Axiaro is represented as one ordinary Seller row of type FIRST_PARTY. It is
// never a hard-coded exception in marketplace code.
//
// Deliberately NOT added in Phase 9C: sellerId on Product / Variant / Inventory
// / Order / OrderItem; SellerOrder; Shipment; commission calculation; payout /
// settlement tables; any seller route or UI.
// ----------------------------------------------------------------------------

// A marketplace merchant. Exactly one FIRST_PARTY row (Axiaro); zero or more
// THIRD_PARTY rows. Seller-scoped data access is enforced in the application
// layer (src/lib/marketplace/seller-repository.ts) — there is no per-seller RLS
// policy in Phase 9C, matching the store's existing "RLS on, no policy" posture.
model Seller {
  id             String   @id @default(cuid())
  type           String   @default("THIRD_PARTY") // FIRST_PARTY | THIRD_PARTY
  status         String   @default("PENDING") // PENDING | APPROVED | SUSPENDED | CLOSED
  displayName    String // customer-facing "Sold by …"
  slug           String   @unique // reserved for a future /seller/<slug> page
  supportEmail   String // customer contact for this seller's orders
  // Marketplace commission withheld from this seller's sales, in BASIS POINTS
  // (1500 = 15.00%). STORED ONLY — Phase 9C never reads or calculates it.
  // FIRST_PARTY (Axiaro) = 0.
  commissionRate Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sellerUsers SellerUser[]
  offers      Offer[]

  @@index([type])
  @@index([status])
}

// Membership of an application User in a Seller, with a seller-scoped role.
// Independent of the global admin RBAC (UserRole / Role / Permission): a person
// may hold both, or either, or neither. Phase 9C ships this as a data model
// only — there is no seller login route and no /seller UI.
model SellerUser {
  id        String   @id @default(cuid())
  sellerId  String
  userId    String
  role      String   @default("STAFF") // OWNER | MANAGER | STAFF
  status    String   @default("INVITED") // ACTIVE | INVITED | DISABLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, userId])
  @@index([userId])
  @@index([sellerId])
}

// The commercial listing: a Seller offering a catalog Variant on specific terms.
// Catalog identity (name, images, specs, reviews) stays on Product / Variant.
model Offer {
  id               String   @id @default(cuid())
  sellerId         String
  variantId        String
  // Commercial terms. In Phase 9C these are COPIES of the catalog values
  // (Variant.price / Variant.compareAtPrice / Product.costPrice) taken once by
  // the backfill. The catalog columns remain the authoritative source for the
  // storefront until a later, separately-approved phase.
  price            Int
  compareAtPrice   Int?
  costPrice        Int?
  // The seller's own SKU for this offer, unique per seller (Postgres treats
  // NULLs as distinct, so a seller may leave it unset). The catalog identifier
  // stays Variant.sku, which is untouched.
  sellerSku        String?
  condition        String   @default("NEW") // NEW | REFURBISHED | USED_LIKE_NEW | USED_GOOD
  status           String   @default("DRAFT") // DRAFT | ACTIVE | INACTIVE | ARCHIVED
  // SELLER_FULFILLED only at launch. PLATFORM_FULFILLED is a reserved future
  // value and must not be used in Phase 9C.
  fulfillmentType  String   @default("SELLER_FULFILLED") // SELLER_FULFILLED | PLATFORM_FULFILLED
  handlingTimeDays Int      @default(2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  seller    Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  variant   Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  inventory OfferInventory?
  // Back-relation only — the FK column lives on CartItem (Phase 9E-1). A deleted
  // Offer nulls the binding (onDelete: SetNull on CartItem.offerId).
  cartItems CartItem[]

  // One offer per (seller, variant, condition).
  @@unique([sellerId, variantId, condition])
  // Seller-scoped SKU uniqueness.
  @@unique([sellerId, sellerSku])
  @@index([sellerId])
  @@index([variantId])
  @@index([status])
}

// Stock owned by exactly one Offer (offerId @unique). Same shape and invariants
// as Inventory. DB CHECK constraints (quantity >= 0, reserved >= 0,
// quantity >= reserved, reorderPoint >= 0) are added in
// supabase/migrations/20260903120000_marketplace_offer_foundation.sql.
model OfferInventory {
  id           String    @id @default(cuid())
  offerId      String    @unique
  sellerSku    String?
  quantity     Int       @default(0)
  reserved     Int       @default(0)
  reorderPoint Int       @default(3)
  restockEta   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  offer       Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  adjustments OfferAdjustment[]

  @@index([offerId])
}

// Append-only history of every quantity change to an OfferInventory row —
// the future equivalent of InventoryAdjustment. The backfill writes exactly one
// row per OfferInventory with reason "MIGRATION_OPENING" to establish the
// opening balance; historical InventoryAdjustment rows are left untouched.
model OfferAdjustment {
  id               String   @id @default(cuid())
  offerInventoryId String
  previousQuantity Int
  delta            Int
  newQuantity      Int
  reason           String // MIGRATION_OPENING | RESTOCK | MANUAL_ADJUSTMENT | DAMAGE | LOSS | RETURN | CORRECTION | SALE | …
  note             String?
  actorUserId      String?
  createdAt        DateTime @default(now())

  offerInventory OfferInventory @relation(fields: [offerInventoryId], references: [id], onDelete: Cascade)

  @@index([offerInventoryId])
  @@index([reason])
  @@index([createdAt])
}
