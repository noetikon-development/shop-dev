// AXIARO — e-commerce data model
// PostgreSQL (works on Vercel / any serverless host). No enums / scalar lists;
// JSON-shaped data is stored as String columns and parsed in the app layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection string (e.g. Neon "pooled" / Vercel POSTGRES_PRISMA_URL).
  url       = env("DATABASE_URL")
  // Non-pooled/direct string, used by `prisma migrate` and `prisma db push`.
  // Set this to the same value as DATABASE_URL if your provider has no separate direct URL.
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Customers
//
// Authentication is handled by Supabase Auth (auth.users). This table holds
// application data only — NO passwords. `supabaseUserId` is the 1:1 link to the
// Supabase Auth user; it is set server-side on first authenticated request.
// ----------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  supabaseUserId String?   @unique
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  role           String    @default("CUSTOMER") // CUSTOMER | ADMIN
  phone          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  wishlist  WishlistItem[]
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String  @default("Home")
  recipient  String
  phone      String
  line1      String
  line2      String?
  barangay   String?
  city       String
  province   String
  region     String?
  postalCode String
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  heroColor   String?    // used for category tiles / headers
  sortOrder   Int        @default(0)
  featured    Boolean    @default(false)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  brand          String   @default("AXIARO")
  shortDescription String
  description    String   // long-form, supports line breaks
  categoryId     String
  status         String   @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED

  price          Int      // selling price, in centavos
  compareAtPrice Int?     // original price for showing a markdown
  costPrice      Int?

  ratingAvg      Float    @default(0)
  ratingCount    Int      @default(0)
  soldCount      Int      @default(0)

  badges         String   @default("[]") // JSON string: ["new","bestseller"]
  highlights     String   @default("[]") // JSON string: bullet list of selling points
  specs          String   @default("{}") // JSON string: { "Material": "Oak", ... }
  care           String?

  freeShipping   Boolean  @default(false)
  weightGrams    Int      @default(500)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category Category      @relation(fields: [categoryId], references: [id])
  images   ProductImage[]
  options  ProductOption[]
  variants Variant[]
  reviews  Review[]
  wishedBy WishlistItem[]

  @@index([categoryId])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  // optional link to a specific option value (e.g. the "Sand" colourway)
  optionValueId String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductOption {
  id        String  @id @default(cuid())
  productId String
  name      String  // "Colour", "Size"
  sortOrder Int     @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id        String  @id @default(cuid())
  optionId  String
  value     String  // "Sand", "Large"
  swatchHex String? // for colour options
  sortOrder Int     @default(0)

  option        ProductOption          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantValues VariantOptionValue[]

  @@index([optionId])
}

model Variant {
  id         String  @id @default(cuid())
  productId  String
  sku        String  @unique
  price      Int     // absolute price for this variant, in centavos
  compareAtPrice Int?
  stock      Int     @default(0) // convenience mirror of Inventory.quantity (source the app currently reads)
  imageUrl   String?

  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  orderItems  OrderItem[]
  inventory   Inventory?

  @@index([productId])
}

// Per-variant stock ledger. `quantity` is on-hand; `reserved` is allocated to
// unfulfilled orders; available = quantity - reserved.
model Inventory {
  id           String    @id @default(cuid())
  variantId    String    @unique
  sku          String
  quantity     Int       @default(0)
  reserved     Int       @default(0)
  reorderPoint Int       @default(3)
  restockEta   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

// join: which option values define a given variant
model VariantOptionValue {
  variantId     String
  optionValueId String

  variant     Variant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

// ----------------------------------------------------------------------------
// Reviews & wishlist
// ----------------------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String?
  body      String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Promotions
// ----------------------------------------------------------------------------

model Coupon {
  id           String   @id @default(cuid())
  code         String   @unique
  description  String?
  type         String   // PERCENT | FIXED | FREESHIP
  value        Int      @default(0) // percent (0-100) or centavos
  minSubtotal  Int      @default(0)
  maxDiscount  Int?
  startsAt     DateTime?
  expiresAt    DateTime?
  usageLimit   Int?
  usedCount    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  orders Order[]
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

model Order {
  id           String   @id @default(cuid())
  orderNumber  String   @unique
  userId       String?
  email        String
  phone        String?

  status       String   @default("PENDING")
  // PENDING | PAID | PROCESSING | SHIPPED | OUT_FOR_DELIVERY | DELIVERED | CANCELLED

  subtotal     Int
  shippingFee  Int      @default(0)
  discountTotal Int     @default(0)
  grandTotal   Int

  couponId     String?
  couponCode   String?

  paymentMethod String  @default("COD") // COD | CARD | GCASH
  paymentStatus String  @default("UNPAID") // UNPAID | PAID | REFUNDED

  addressId       String?
  shippingAddress String // JSON string snapshot at time of order
  shippingMethod  String @default("standard")

  note         String?
  placedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  address Address? @relation(fields: [addressId], references: [id])
  coupon  Coupon?  @relation(fields: [couponId], references: [id])
  items   OrderItem[]
  events  OrderEvent[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  name         String
  variantLabel String?
  sku          String?
  imageUrl     String?
  unitPrice    Int
  quantity     Int
  lineTotal    Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  title     String
  detail    String?
  location  String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ----------------------------------------------------------------------------
// Store configuration (key/value). Seeded from src/lib/constants.ts. The
// storefront still reads constants.ts today; moving reads here is a later step.
// ----------------------------------------------------------------------------

model StoreSetting {
  key       String   @id
  value     String // JSON-encoded value
  type      String   @default("string") // string | number | boolean | json
  label     String?
  group     String   @default("general")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([group])
}
